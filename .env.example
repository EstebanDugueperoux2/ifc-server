# IFC-Lite Server Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Port to expose the server on (maps to internal port 8080)
PORT=3001

# Log level: error, warn, info, debug, trace
# Use "debug" for development, "info" for production
RUST_LOG=info

# =============================================================================
# FILE PROCESSING
# =============================================================================

# Maximum IFC file size in megabytes
# Larger files need more memory and processing time
MAX_FILE_SIZE_MB=500

# Request timeout in seconds
# Increase for very large files (500MB+)
REQUEST_TIMEOUT_SECS=300

# Number of worker threads for parallel geometry processing
# Default: number of CPU cores
# Reduce if running alongside other services
WORKER_THREADS=4

# =============================================================================
# STREAMING (Progressive Rendering)
# =============================================================================

# Initial batch size for fast first frame (first 3 batches)
# Smaller = faster first render, but more HTTP overhead
INITIAL_BATCH_SIZE=100

# Maximum batch size for throughput (batches 11+)
# Larger = better throughput, but longer waits between updates
MAX_BATCH_SIZE=1000

# =============================================================================
# CACHING
# =============================================================================

# How long to keep cached results (in days)
# Cached files are served instantly without reprocessing
CACHE_MAX_AGE_DAYS=7

# =============================================================================
# AI ASSISTANT (chat in the webapp: create / query / edit IFC models)
# =============================================================================

# AI Provider Selection
# Supported providers: anthropic, openai, mistral, google
# Default: openai
ASSISTANT_PROVIDER=openai

# ----------------------------------------------------------------------------
# ANTHROPIC CONFIGURATION
# ----------------------------------------------------------------------------
# Required for Anthropic provider (not the default)
ANTHROPIC_API_KEY=

# Base URL for Anthropic API (default: https://api.anthropic.com)
ANTHROPIC_BASE_URL=

# Model used by the assistant (any Claude model that supports tool use)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Request timeout for Anthropic API in seconds (default: 120)
ANTHROPIC_TIMEOUT_SEC=120

# ----------------------------------------------------------------------------
# OPENAI CONFIGURATION (DEFAULT PROVIDER)
# ----------------------------------------------------------------------------
# Required for OpenAI provider
OPENAI_API_KEY=

# Base URL for OpenAI API (default: https://api.openai.com/v1)
OPENAI_BASE_URL=

# Model used for OpenAI (e.g., gpt-4, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4

# Request timeout for OpenAI API in seconds
OPENAI_TIMEOUT_SEC=120

# ----------------------------------------------------------------------------
# MISTRAL CONFIGURATION
# ----------------------------------------------------------------------------
# Required for Mistral provider
MISTRAL_API_KEY=

# Base URL for Mistral API (default: https://api.mistral.ai/v1)
MISTRAL_BASE_URL=

# Model used for Mistral (e.g., mistral-large, mistral-small)
MISTRAL_MODEL=mistral-large

# Request timeout for Mistral API in seconds
MISTRAL_TIMEOUT_SEC=120

# ----------------------------------------------------------------------------
# GOOGLE (GEMINI) CONFIGURATION
# ----------------------------------------------------------------------------
# Required for Google provider
GOOGLE_API_KEY=

# Base URL for Google API (default: https://generativelanguage.googleapis.com/v1beta)
GOOGLE_BASE_URL=

# Model used for Google (e.g., gemini-pro, gemini-1.5-pro)
GOOGLE_MODEL=gemini-pro

# Request timeout for Google API in seconds
GOOGLE_TIMEOUT_SEC=120

# ----------------------------------------------------------------------------
# COMMON ASSISTANT SETTINGS (applied to all providers)
# ----------------------------------------------------------------------------

# Port to expose the assistant on (bound to 127.0.0.1 by default)
ASSISTANT_PORT=3003

# Optional bearer token required on /api/v1/chat. Strongly recommended as soon as
# the assistant is reachable by anyone else: every request spends API credits.
ASSISTANT_API_TOKEN=

# true = only query tools are offered (no create_model or edits)
ASSISTANT_READ_ONLY=false

# Comma-separated browser origins allowed to call the assistant API
CORS_ALLOWED_ORIGINS=

# Maximum tokens to generate per response (default: 4096)
MAX_TOKENS=4096

# Maximum steps in a conversation turn (default: 12)
MAX_STEPS=12

# Maximum number of active conversations (default: 50)
MAX_CONVERSATIONS=50

# Conversation TTL in minutes (default: 30)
CONVERSATION_TTL_MIN=30

# Maximum message length in characters (default: 4000)
MAX_MESSAGE_CHARS=4000
